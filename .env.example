# Jacques environment configuration.
# Copy to .env.local and fill in real values for AI-backed features.

# Plan/ask/vision/heartbeat/image model calls are proxied through OpenRouter from
# server routes; the browser never sees this key.
OPENROUTER_API_KEY=

# Server-only. Used solely to mint short-lived Realtime API client secrets
# (POST /v1/realtime/client_secrets) for voice narration + spoken Q&A. The raw
# key never reaches the browser; only the ephemeral secret does.
OPENAI_API_KEY=
# Used by the CopilotKit runtime's built-in agent.
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional; enables the managed CopilotKit Intelligence dashboard.
CPK_INTELLIGENCE_API_KEY=
